def icecreamParlor(m, arr):
    result = []
    n = len(arr)
    for i in range(n):
        if arr[i] < m:
            for j in range(i+1,n):
                if (m-arr[i]) == arr[j]:
                    result.append(i+1)
                    result.append(j+1)
                    return result
        

